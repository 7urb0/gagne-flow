# =============================================================================
# GagneFlow 环境变量配置模板
# 使用方法:
#   1. 复制为 .env:  cp .env.example .env
#   2. 编辑 .env 填入真实值
#   3. .env 不会被提交到 Git（已在 .gitignore 中排除）
# =============================================================================

# --- LLM: 阿里云 DashScope (必填) ---
# 获取 Key: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-请替换为你的真实Key

# --- 向量数据库: Milvus ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 如果启用了认证，取消下面两行的注释并填入凭据
# MILVUS_USERNAME=your_username
# MILVUS_PASSWORD=your_password
MILVUS_DATABASE=default

# --- 缓存: Redis（会话持久化） ---
REDIS_HOST=localhost
REDIS_PORT=6379
# 如果启用了密码认证，取消注释
# REDIS_PASSWORD=your_password

# --- 监控: Prometheus (可选) ---
PROMETHEUS_BASE_URL=http://localhost:9090
# 本地测试 Mock 模式（不依赖真实 Prometheus）
PROMETHEUS_MOCK_ENABLED=true

# --- 日志服务: 腾讯云 CLS (可选) ---
# 如不使用腾讯云 CLS，设置 MCP_ENABLED=false 并 CLS_MOCK_ENABLED=true
MCP_ENABLED=true
# 从腾讯云 CLS 控制台获取 SSE 端点路径
MCP_CLS_SSE_ENDPOINT=/sse/请替换为你的端点
# 本地测试 Mock 模式（不依赖真实 CLS）
CLS_MOCK_ENABLED=true

# --- RAG 检索参数 ---
RAG_TOP_K=3
RAG_MODEL=qwen-max-latest

# --- 文档分片 ---
DOCUMENT_CHUNK_MAX_SIZE=800
DOCUMENT_CHUNK_OVERLAP=100

# --- Embedding 模型 ---
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# --- 文件上传 ---
FILE_UPLOAD_PATH=./uploads
FILE_UPLOAD_ALLOWED_EXTENSIONS=txt,md,pdf,docx

# --- CORS 跨域白名单（生产环境改为具体域名） ---
CORS_ALLOWED_ORIGINS=http://localhost:9900,http://localhost:5173

# --- DashScope SDK ---
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# --- JWT 认证密钥（生产环境必填，至少 32 字节） ---
# 生成命令: openssl rand -base64 32
# 注意：不配置或密钥太短将导致应用启动失败
JWT_SECRET=请替换为至少32字节的随机密钥

# --- 服务端口 ---
SERVER_PORT=9900
